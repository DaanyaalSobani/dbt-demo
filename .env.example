# marry-lambda deployment configuration
# --------------------------------------
# Copy this file to .env and fill it in:
#
#   cp .env.example .env
#
# .env is git-ignored because it holds live AWS keys. NEVER commit it.

# --- AWS credentials (SECRET — treat like passwords) -------------------------
# Create these in the AWS console:
#   IAM > Users > your user > Security credentials > Create access key >
#   choose "Command Line Interface (CLI)"
# The AWS CLI reads these environment variables natively, so no
# `aws configure` step is needed anywhere in this project.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed if you use temporary credentials (AWS SSO, STS, an assumed
# role). Leave commented out for standard long-lived IAM user access keys.
# AWS_SESSION_TOKEN=

# --- Region (not secret) -----------------------------------------------------
# Both variables are set because different AWS tools read different ones.
# Keep them identical. us-east-1 is a fine default.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# --- Deployment config (not secret — safe defaults, change if you like) ------
FUNCTION_NAME=marry-lambda
ROLE_NAME=marry-lambda-exec-role
RUNTIME=python3.13
HANDLER=handler.lambda_handler
